# Local Postgres (docker compose up -d)
DATABASE_URL="postgresql://dealport:dealport@localhost:5432/dealport"
# Neon direct URL in production; same as DATABASE_URL locally. Migrations only.
DIRECT_URL="postgresql://dealport:dealport@localhost:5432/dealport"

JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Optional locally — absent means uploads return 501, rest of the API works
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_ENV=development
