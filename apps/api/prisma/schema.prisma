// DEALPORT data model — see plans/01-ARCHITECTURE.md §4
//
// Every Product field below backs a control on the Add Product screen.
// Order / OrderItem are read-only: seeded so the Dashboard aggregates real rows,
// never written by the app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
}

enum OrderStatus {
  PAID
  PENDING
  CANCELED
}

enum PaymentMethod {
  CC
  PAYPAL
  BANK_TRANSFER
  COD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products    Product[]
  loginEvents LoginEvent[]

  @@map("users")
}

// One row per login attempt (success and failure) — an audit trail of who
// logged in when, from where, and with what client. `email`/`success` are
// kept even when `userId` is null so failed attempts against unknown emails
// still show up in the trail.
model LoginEvent {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("login_events")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] @relation("ProductTags")

  @@map("tags")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  sku         String  @unique
  description String?

  // Money as Decimal(10,2) — binary float rounding is visible on a price field
  price           Decimal  @db.Decimal(10, 2)
  discountedPrice Decimal? @db.Decimal(10, 2)
  taxIncluded     Boolean  @default(true)
  currency        String   @default("USD")

  saleStartsAt DateTime?
  saleEndsAt   DateTime?

  stockQuantity  Int?
  unlimitedStock Boolean     @default(false)
  stockStatus    StockStatus @default(IN_STOCK)

  // "Publish Product" vs "Save to draft" on the Add Product screen
  status   ProductStatus @default(DRAFT)
  featured Boolean       @default(false)

  colors String[] @default([])

  // Denormalised sales counter — powers Best Selling / Top Products ordering
  totalOrders Int @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  tags       Tag[]          @relation("ProductTags")
  images     ProductImage[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Exactly the columns the Product List filters and sorts by
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@index([totalOrders])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Order {
  id           String        @id @default(cuid())
  reference    String        @unique
  customerRef  String
  customerName String
  status       OrderStatus   @default(PAID)
  method       PaymentMethod @default(CC)
  amount       Decimal       @db.Decimal(10, 2)
  placedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())

  items OrderItem[]

  @@index([placedAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
